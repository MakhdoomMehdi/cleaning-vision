# Copy to .env and adjust. Never commit .env.

APP_ENV=local
LOG_LEVEL=INFO

# Comma-separated list of allowed frontend origins (local dev only by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage (SQLite + local disk for the MVP)
DATABASE_URL=sqlite:///./data/cleaning_vision.db
UPLOAD_DIR=./uploads

# Upload limits
MAX_UPLOAD_MB=10
MIN_IMAGE_DIMENSION=320
MAX_IMAGE_DIMENSION=8000
MAX_IMAGES_PER_REQUEST=6
MAX_REFERENCE_IMAGES_PER_INSPECTION=12

# YOLO (local, CPU inference)
YOLO_MODEL_PATH=yolo11n.pt
YOLO_CONF_THRESHOLD=0.25
YOLO_IOU_THRESHOLD=0.45
YOLO_DEVICE=cpu

# OpenAI (key stays on the backend; never exposed to the frontend)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=2
